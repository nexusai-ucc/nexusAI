# Entorno
ENV=production
APP_VERSION=0.1.0

# LLM (Google Gemini via OpenAI-compatible endpoint)
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.0-flash

# Embeddings
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Credenciales de Postgres — generar nuevas, no reusar las de dev local
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_DB=nexusai

# Base de datos Postgres (container interno del compose, red nexusai-net)
DATABASE_URL=postgresql+asyncpg://nexusai:REPLACE_WITH_openssl_rand_hex_32@postgres:5432/nexusai

# Redis (container interno del compose, red nexusai-net)
REDIS_URL=redis://redis:6379/0

# Seguridad — generar con: openssl rand -hex 32
NEXUSAI_SHARED_SECRET=REPLACE_WITH_openssl_rand_hex_32
NEXUSAI_API_KEY=REPLACE_WITH_openssl_rand_hex_32
HMAC_REPLAY_WINDOW_SEC=300

# Rate limiting
RATE_LIMIT_PER_USER_DAILY=50
