# Entorno
ENV=production
APP_VERSION=0.1.0

# LLM (Google Gemini via OpenAI-compatible endpoint)
# Google retira modelos viejos sin aviso — verificá que el que ponés siga vivo:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$LLM_API_KEY"
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# Thinking / razonamiento (PERF-01). "none" = sin razonamiento interno, que es
# lo que baja el tiempo hasta el primer token de ~45s a ~1-3s. Ver .env.example.
LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT_GENERATION=low

# Resúmenes de documentos (PERF-02) — cache en Redis y paralelismo del
# resumen pre-parcial. Ver .env.example para el detalle.
SUMMARY_CACHE_TTL_SEC=86400
SUMMARY_MAX_CONCURRENCY=4

# Embeddings
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Credenciales de Postgres — generar nuevas, no reusar las de dev local
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=REPLACE_WITH_openssl_rand_hex_32
POSTGRES_DB=nexusai

# Base de datos Postgres (container interno del compose, red nexusai-net)
DATABASE_URL=postgresql+asyncpg://nexusai:REPLACE_WITH_openssl_rand_hex_32@postgres:5432/nexusai

# Redis (container interno del compose, red nexusai-net)
REDIS_URL=redis://redis:6379/0

# Seguridad — generar con: openssl rand -hex 32
NEXUSAI_SHARED_SECRET=REPLACE_WITH_openssl_rand_hex_32
NEXUSAI_API_KEY=REPLACE_WITH_openssl_rand_hex_32
HMAC_REPLAY_WINDOW_SEC=300

# Rate limiting
RATE_LIMIT_PER_USER_DAILY=50
