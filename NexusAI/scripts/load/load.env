# Ambiente de las pruebas de carga (TPC-09, #581). Solo para el backend
# efímero que levanta run_load.sh: nada de esto existe en staging ni en prod.
# Los valores de autenticación son de prueba, no son secretos.
ENV=load
APP_VERSION=0.1.0

# El LLM y los embeddings los sirve scripts/load/mock_llm.py (servicio mock-llm).
LLM_API_KEY=mock
LLM_BASE_URL=http://mock-llm:9000/v1/
LLM_MODEL=mock-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
EMBEDDING_API_KEY=mock
EMBEDDING_BASE_URL=http://mock-llm:9000/v1/
EMBEDDING_MODEL=mock-embedding
EMBEDDING_DIMENSIONS=768

POSTGRES_USER=nexusai
POSTGRES_PASSWORD=load-test-only
POSTGRES_DB=nexusai

# pgadmin no se levanta, pero compose interpola todos los servicios del archivo
# y estas dos son obligatorias.
PGADMIN_EMAIL=load@nexusai.local
PGADMIN_PASSWORD=load-test-only

NEXUSAI_API_KEY=load-test-api-key
NEXUSAI_SHARED_SECRET=load-test-shared-secret
HMAC_REPLAY_WINDOW_SEC=300

# Moderación encendida, como en producción: sin MODERATION_API_KEY pasa por
# el LLM (una llamada extra por pregunta, que el mock responde como "no flagged").
MODERATION_ENABLED=true
MODERATION_FAIL_OPEN=true

# Límites: el POR MINUTO queda real (20) — el escenario rate_limit lo verifica
# bajo carga. El diario y el presupuesto de tokens se abren: cada VU es un
# alumno distinto y las corridas largas superarían los límites de un día real,
# que no es lo que se mide acá.
RATE_LIMIT_PER_USER_MINUTE=20
RATE_LIMIT_PER_USER_DAILY=100000
TOKEN_BUDGET_STUDENT_HOURLY=100000000
TOKEN_BUDGET_STUDENT_DAILY=100000000
TOKEN_BUDGET_TEACHER_HOURLY=100000000
TOKEN_BUDGET_TEACHER_DAILY=100000000
