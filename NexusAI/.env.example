# ============================================================
# NexusAI — Variables de entorno
# ============================================================
#
# Uso:
#   1. cp .env.example .env
#   2. Completar valores marcados con REPLACE_ME y CHANGE_ME_DEV_ONLY
#   3. Generar secretos HMAC con:  openssl rand -hex 32
#
# IMPORTANTE: NUNCA commitear el .env real (está en .gitignore).
# Los valores CHANGE_ME_DEV_ONLY son SOLO para desarrollo local — en producción
# generar passwords fuertes con `openssl rand -base64 24`.
#
# ============================================================

# ----- Entorno de ejecución -----
ENV=development
APP_VERSION=0.1.0

# ============================================================
# LLM Provider — Multi-provider abstracción (ver ADR-003)
# ============================================================
# MVP: Gemini Flash (gratuito, tier free de Google)
# Conseguir API key en: https://aistudio.google.com/apikey
#
# OJO con qué modelo ponés acá: Google retira modelos viejos sin aviso. Al
# 2026-09, gemini-2.0-flash y gemini-2.5-flash-lite ya devuelven 404, y
# gemini-2.5-flash está saturado en el tier gratuito (503 seguidos + ~45s
# hasta el primer token). Verificá qué tenés disponible con:
#   curl "https://generativelanguage.googleapis.com/v1beta/models?key=$LLM_API_KEY"

LLM_API_KEY=REPLACE_ME_WITH_GEMINI_API_KEY
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash

# ----- Thinking / razonamiento (PERF-01) -----
# Los flash 2.5+ razonan internamente antes del primer token. Ese razonamiento
# no se ve, no se streamea, y es el grueso de la latencia percibida.
#   "none" (default)  → sin razonamiento; ~1-3s al primer token en el chat.
#   "low"/"medium"/"high" → más calidad, más segundos de espera.
#   "default"/"auto"/vacío → no manda el parámetro; decide el modelo.
# LLM_REASONING_EFFORT pisa el default de TODAS las llamadas.
# LLM_REASONING_EFFORT_GENERATION aplica solo a la generación de preguntas de
# quiz y de examen, donde la calidad justifica pagar los segundos extra.
LLM_REASONING_EFFORT=none
LLM_REASONING_EFFORT_GENERATION=low

# ----- Producción (descomenta y comenta el bloque MVP de arriba) -----
# LLM_API_KEY=sk-REPLACE_ME_WITH_OPENAI_API_KEY
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# ----- Fallback automático (opcional, INFRA-01 / issue #307) -----
# Si el proveedor primario de arriba agota su cuota (429) o cae (503),
# se reintenta automáticamente contra este secundario antes de fallar.
# Sin estas 3 vars, el fallback queda deshabilitado. Ver services/api/README.md.
# LLM_FALLBACK_API_KEY=sk-REPLACE_ME_WITH_OPENAI_API_KEY
# LLM_FALLBACK_BASE_URL=https://api.openai.com/v1
# LLM_FALLBACK_MODEL=gpt-4o-mini

# ----- Cadena de modelos intermedios de Gemini (opcional, INFRA-03 / issue #343) -----
# Google AI Studio da cuota gratuita POR MODELO. Antes de pasar al secundario
# de arriba, prueba estos modelos en orden usando la MISMA LLM_API_KEY/LLM_BASE_URL
# del primario (no son otro proveedor, solo otro modelo). Vacío = deshabilitado.
# Verificá que existan antes de ponerlos (ver el curl de más arriba).
# LLM_INTERMEDIATE_MODELS=gemini-3.8-flash,gemini-3.1-flash-lite

# ----- Transcripción de voz (opcional, VOICE-01 / issue #314) -----
# Ningún proveedor de arriba sirve para transcripción: Gemini no la expone
# por el shim OpenAI-compat que usamos, y el fallback OpenAI está deshabilitado
# salvo que lo actives arriba. Groq sí expone Whisper compatible con el mismo
# SDK. Conseguí una key gratis en https://console.groq.com/keys — sin ella,
# el botón de micrófono del chat devuelve un error claro en vez de fallar feo.
# GROQ_API_KEY=gsk_REPLACE_ME_WITH_GROQ_API_KEY
# GROQ_STT_MODEL=whisper-large-v3

# ============================================================
# Resúmenes de documentos (PERF-02)
# ============================================================
# SUMMARY_CACHE_TTL_SEC: cuánto vive en Redis el resumen ya generado de un
#   documento. La key incluye el hash del archivo, así que reemplazar un
#   documento invalida su entrada sola. 0 = sin cache.
# SUMMARY_MAX_CONCURRENCY: resúmenes pedidos al LLM en paralelo dentro del
#   resumen pre-parcial. Más alto = más rápido, pero contra la cuota gratuita
#   de Gemini aumenta la chance de 429/503.
SUMMARY_CACHE_TTL_SEC=86400
SUMMARY_MAX_CONCURRENCY=4

# ============================================================
# Embedding Provider
# ============================================================
# MVP: Gemini Embedding (768 dim, gratuito)

EMBEDDING_API_KEY=REPLACE_ME_WITH_GEMINI_API_KEY
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_MODEL=models/text-embedding-004
EMBEDDING_DIMENSIONS=768

# ----- Producción (descomenta y comenta el bloque MVP) -----
# EMBEDDING_API_KEY=sk-REPLACE_ME
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# ============================================================
# Base de datos PostgreSQL + pgvector (ADR-002)
# ============================================================
# Estos valores los usa docker-compose para crear la DB
# Y el backend para conectarse

POSTGRES_USER=nexusai
POSTGRES_PASSWORD=CHANGE_ME_DEV_ONLY
POSTGRES_DB=nexusai
POSTGRES_PORT=5432

# DATABASE_URL — el backend usa esto. En docker-compose se sobrescribe automáticamente
# para apuntar al servicio interno `postgres` en lugar de `localhost`.
DATABASE_URL=postgresql://nexusai:CHANGE_ME_DEV_ONLY@localhost:5432/nexusai

# ============================================================
# Redis — cache + rate limiting + nonce tracking
# ============================================================

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

# ============================================================
# Seguridad — HMAC PHP↔Python (ADR-006 a formalizar)
# ============================================================
# Generar con:  openssl rand -hex 32

NEXUSAI_SHARED_SECRET=REPLACE_WITH_HEX_32_FROM_OPENSSL
NEXUSAI_API_KEY=REPLACE_WITH_HEX_32_FROM_OPENSSL
HMAC_REPLAY_WINDOW_SEC=300

# ============================================================
# Rate limiting
# ============================================================

RATE_LIMIT_PER_USER_DAILY=50

# ============================================================
# Backend API
# ============================================================

API_PORT=8001

# ============================================================
# Moodle (solo se usa con profile `full`)
# ============================================================

MOODLE_PORT=8080
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CHANGE_ME_DEV_ONLY
MOODLE_ADMIN_EMAIL=admin@nexusai.local

# ============================================================
# pgAdmin (solo se usa con profile `tools`)
# ============================================================

PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@nexusai.local
PGADMIN_PASSWORD=CHANGE_ME_DEV_ONLY
