{
  "name": "local_nexusai-react",
  "version": "0.1.0",
  "private": true,
  "description": "React widget embebido en el plugin Moodle local_nexusai. Compila a un bundle AMD único en ../amd/build/.",
  "scripts": {
    "build": "webpack --mode production",
    "dev": "webpack --mode development --watch",
    "clean": "rm -rf ../amd/build/*.js ../amd/build/*.map",
    "test": "node scripts/run-vitest.js run",
    "test:watch": "node scripts/run-vitest.js"
  },
  "dependencies": {
    "dompurify": "^3.4.7",
    "marked": "^12.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "temml": "^0.11.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^3.2.7",
    "babel-loader": "^9.1.3",
    "css-loader": "^7.1.0",
    "jsdom": "^27.0.1",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "vitest": "^3.2.7",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "not dead",
    "not IE 11"
  ]
}
