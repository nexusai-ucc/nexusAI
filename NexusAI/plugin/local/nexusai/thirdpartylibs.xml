<?xml version="1.0"?>
<!--
PUB-01 (issue #309): declares the third-party libraries packaged inside the
compiled React/webpack bundle in amd/build/ — required by moodle.org for any
plugin that distributes third-party code. The (uncompiled) source is in
react/package.json; this documents what actually ends up minified inside the
two committed AMD bundles.
-->
<libraries>
    <library>
        <name>react</name>
        <location>amd/build/chatwidget-lazy.min.js</location>
        <version>18.3.1</version>
        <license>MIT</license>
    </library>
    <library>
        <name>react</name>
        <location>amd/build/documents-manager-lazy.min.js</location>
        <version>18.3.1</version>
        <license>MIT</license>
    </library>
    <library>
        <name>react-dom</name>
        <location>amd/build/chatwidget-lazy.min.js</location>
        <version>18.3.1</version>
        <license>MIT</license>
    </library>
    <library>
        <name>react-dom</name>
        <location>amd/build/documents-manager-lazy.min.js</location>
        <version>18.3.1</version>
        <license>MIT</license>
    </library>
    <library>
        <name>react-markdown</name>
        <location>amd/build/chatwidget-lazy.min.js</location>
        <version>9.1.0</version>
