# Entorno de la demo de la defensa. Copiar a .env (que no se commitea) y completar.
# Los valores REPLACE_ME se generan o se copian del panel de cada servicio:
# nunca se pegan en un chat ni en un issue.

# ── Sitio ────────────────────────────────────────────────────────────────
# Servidor: el dominio, sin https:// (Caddy saca el certificado).
# Local:    http://localhost  y  HTTP_PORT=8088
DEMO_SITE_ADDRESS=demo.ejemplo.com
# URL pública con la que se entra a Moodle (la del QR).
MOODLE_WWWROOT=https://demo.ejemplo.com
HTTP_PORT=80
HTTPS_PORT=443

# ── Moodle ───────────────────────────────────────────────────────────────
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=REPLACE_ME
MOODLE_ADMIN_EMAIL=admin@ejemplo.com
# Ruta al código de Moodle 4.5. Vacío = lo clona setup.sh en ./moodle
MOODLE_SRC=

# ── Base de datos (la comparten el backend y Moodle) ─────────────────────
POSTGRES_USER=nexusai
POSTGRES_PASSWORD=REPLACE_ME

# ── Backend ──────────────────────────────────────────────────────────────
ENV=demo
APP_VERSION=demo-defensa
# openssl rand -hex 32 (las dos)
NEXUSAI_API_KEY=REPLACE_ME
NEXUSAI_SHARED_SECRET=REPLACE_ME
HMAC_REPLAY_WINDOW_SEC=300

# Modelo: OpenAI gpt-4o-mini, con la key del proyecto de la demo (tope de gasto activado).
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://api.openai.com/v1/
LLM_MODEL=gpt-4o-mini
# Sin fallback por ahora; se puede sumar un segundo proveedor de chat.
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# Embeddings: text-embedding-3-small pedido en 768 dimensiones. Las migraciones
# 009 y 017 fijan vector(768) en foros y vacíos, así que no usar 1536.
EMBEDDING_API_KEY=REPLACE_ME
EMBEDDING_BASE_URL=https://api.openai.com/v1/
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=768

# Moderación con la API de moderación de OpenAI. Si falla la moderación, se bloquea
# el mensaje: en la demo lo que escribe el público se proyecta.
MODERATION_ENABLED=true
MODERATION_API_KEY=REPLACE_ME
MODERATION_FAIL_OPEN=false

# Límites por usuario: cada persona del público tiene su cuenta.
RATE_LIMIT_PER_USER_MINUTE=20
RATE_LIMIT_PER_USER_DAILY=200
